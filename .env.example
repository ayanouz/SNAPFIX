# SNAPFIX — environment variables
# Copy to .env and fill values. Only EXPO_PUBLIC_* values are bundled into the app.
# NEVER put service-role keys or AI API keys in EXPO_PUBLIC_* variables.

# --- Mobile app (public) ---
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Demo mode is explicit. Live mode is the default when Supabase values are present.
# Set "true" to force the local demo, or "false" for live mode.
EXPO_PUBLIC_ENABLE_DEMO_MODE=true
# Support / contact address shown in the app.
EXPO_PUBLIC_SUPPORT_EMAIL=support@example.com
# Optional: restrict analytics to this environment label.
EXPO_PUBLIC_ENVIRONMENT=development

# --- Supabase Edge Functions (server-only secrets) ---
# Set with: npx supabase secrets set AI_PROVIDER=openai AI_API_KEY=... AI_MODEL=...
# AI provider: openai | anthropic | gemini | demo
AI_PROVIDER=demo
AI_API_KEY=
AI_MODEL=
# OpenAI-compatible base URL. Leave empty for https://api.openai.com/v1.
AI_BASE_URL=
# Explicit opt-in is required to run the deterministic demo analyzer in a deployment.
AI_ALLOW_DEMO=false
# Request timeout in milliseconds.
AI_TIMEOUT_MS=60000
# Optional provider response token cap (capped at 8192 by the function).
AI_MAX_TOKENS=4096
# Region used to match verified price references (ISO country code or "global").
PRICE_REGION=MA
# Shared secret used by the billing webhook. Generate a long random value.
BILLING_WEBHOOK_SECRET=
# Comma-separated allowed origins for browser clients. Native apps omit Origin.
ALLOWED_ORIGINS=
