{
  "name": "snapfix",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "lint:fix": "expo lint --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --runInBand",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "doctor": "expo-doctor",
    "assets": "powershell -ExecutionPolicy Bypass -File scripts/generate-assets.ps1",
    "export:android": "expo export --platform android",
    "export:ios": "expo export --platform ios"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.5",
    "expo": "~58.0.19",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.17",
    "expo-image-manipulator": "~58.0.15",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-localization": "~58.0.5",
    "expo-network": "~58.0.4",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.20",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
